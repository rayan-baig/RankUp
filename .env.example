# ---------------------------------------------------------------------------
# RankUp environment variables. Copy this file to `.env` and fill in values.
# Anything starting with VITE_ is readable by the browser — never put a secret
# API key in one of those.
# ---------------------------------------------------------------------------

# Where the browser should send photos for the AI check.
# Leave blank to run the built-in on-device checks only (no key required).
VITE_AI_VERIFY_URL=/api/verify-photo

# SERVER-SIDE ONLY (used by api/verify-photo.js on Vercel/Netlify).
# This is a secret. It must NOT be prefixed with VITE_.
ANTHROPIC_API_KEY=

# Supabase. Setting BOTH of these switches device pairing from "two tabs of this
# browser" to real phone-to-phone pairing. Run supabase/schema.sql first.
# See docs/SYNC.md and docs/BACKEND.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Push notifications. Generate with: npx web-push generate-vapid-keys
# Without these the app still notifies, but only while it is open.
# See docs/NOTIFICATIONS.md
# ---------------------------------------------------------------------------
VITE_VAPID_PUBLIC_KEY=

# SERVER-SIDE ONLY. Never prefix these with VITE_.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# The service role key bypasses every row level security rule. Host environment
# variables only — never the repository, never a VITE_ name.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe. Leave VITE_STRIPE_ENABLED unset to run without billing — the plan
# screen then flips tiers locally for testing and says so.
# See docs/PAYMENTS.md
# ---------------------------------------------------------------------------
VITE_STRIPE_ENABLED=

# SERVER-SIDE ONLY. The secret key can charge cards; the webhook secret is what
# stops anyone posting a fake "subscription active" and taking Elite for free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_ELITE=price_...
