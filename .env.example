# ---------------------------------------------------------------------------
# RankUp environment variables. Copy this file to `.env` and fill in values.
#
# THE ONE RULE: anything starting with VITE_ is compiled into the JavaScript
# every phone downloads. A secret in a VITE_ name is a published secret. The
# app checks for this at start-up and shouts in the console if it finds one.
#
# Everything here is optional — the app runs with none of it, on one device,
# with no account. Each block says what switching it on buys you.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# 1. The backend. Set BOTH and pairing stops being "two tabs of this browser"
#    and becomes two real phones. Run the files in supabase/ first, in the
#    order docs/BACKEND.md gives.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The same URL again, for the server functions, plus the key that bypasses
# every row level security rule. Host environment variables only — never the
# repository, never a VITE_ name.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# 2. Where this site lives, e.g. https://rankup.example.com
#
# Stripe sends people back here after paying, so it must be the real public
# address and it must be absolute. Without it, checkout and the billing portal
# refuse to start rather than sending somebody to a broken page.
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL=


# ---------------------------------------------------------------------------
# 3. The AI photo check. Optional: with no key the on-device checks still run,
#    and the app says the cloud check did not. See docs/AI-CHECK.md.
# ---------------------------------------------------------------------------
VITE_AI_VERIFY_URL=/api/verify-photo

# SERVER-SIDE ONLY. This is a secret. It must NOT be prefixed with VITE_.
ANTHROPIC_API_KEY=
# Haiku 4.5 by default, chosen for cost. claude-opus-5 trades money for judgement.
AI_VERIFY_MODEL=


# ---------------------------------------------------------------------------
# 4. Push notifications. Generate a pair with:
#      npx web-push generate-vapid-keys
#    Without these the app still notifies, but only while it is open.
#    See docs/NOTIFICATIONS.md.
# ---------------------------------------------------------------------------
VITE_VAPID_PUBLIC_KEY=

# SERVER-SIDE. The public key is repeated here because the send endpoint needs
# it too; the private key signs the pushes and must never be in a VITE_ name.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com


# ---------------------------------------------------------------------------
# 5. Stripe. Leave VITE_STRIPE_ENABLED unset to run without billing — the plan
#    screen then flips tiers locally for testing and says so.
#    See docs/PAYMENTS.md.
# ---------------------------------------------------------------------------
VITE_STRIPE_ENABLED=

# SERVER-SIDE ONLY. The secret key can charge cards; the webhook secret is what
# stops anyone posting a fake "subscription active" and taking Elite for free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The three subscription prices. Create them as MONTHLY recurring prices.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_ELITE=price_...

# The three Flash Ticket packs — one-off payments, not subscriptions. How many
# tickets each pack grants is fixed in api/create-checkout.js, so a caller
# cannot buy the small pack and be credited the large one.
STRIPE_PRICE_FLASH_2=price_...
STRIPE_PRICE_FLASH_5=price_...
STRIPE_PRICE_FLASH_12=price_...


# ---------------------------------------------------------------------------
# 6. The scheduled jobs: retention, reminders and the monthly alliance
#    settlement. One long random string protects all three.
#
#      openssl rand -hex 32
#
#    Without it the jobs refuse every caller, including your scheduler, and
#    /api/health says scheduled_jobs is not configured. Photos then never get
#    deleted, which is the one you would notice last and care about most.
# ---------------------------------------------------------------------------
CRON_SECRET=

# How long things are kept before the retention job removes them. The defaults
# are in api/run-retention.js; set these only to override.
RETENTION_PHOTO_DAYS=
RETENTION_EVENT_DAYS=
RETENTION_PAIRING_DAYS=

# How late a daily reminder may still be sent, if the scheduler ran behind.
REMINDER_GRACE_MINUTES=


# ---------------------------------------------------------------------------
# 7. Guilds are OFF unless this is exactly 'true'. They are the only feature
#    that puts a child in touch with children in other families, which is by
#    far the heaviest thing to be responsible for. Launch without them; switch
#    them on when you are ready to carry it. See docs/LAUNCH.md.
# ---------------------------------------------------------------------------
VITE_GUILDS_ENABLED=


# ---------------------------------------------------------------------------
# 8. Only if the server functions are NOT served from the same origin as the
#    app — a separate Netlify Functions site, say. Otherwise leave them alone;
#    the defaults below are what the app uses.
# ---------------------------------------------------------------------------
# VITE_CHECKOUT_URL=/api/create-checkout
# VITE_PORTAL_URL=/api/billing-portal
# VITE_PUSH_SEND_URL=/api/send-push
